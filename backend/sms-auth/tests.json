{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Send without email",
      "method": "POST",
      "path": "/",
      "body": {"action": "send_email", "email": ""},
      "expectedStatus": 400,
      "expectedBody": {"error": "Укажите корректный email"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Verify without prior send",
      "method": "POST",
      "path": "/",
      "body": {"action": "verify", "email": "test@test.ru", "code": "12345"},
      "expectedStatus": 400,
      "expectedBody": {"error": "Сначала запросите код"},
      "bodyMatcher": "partial"
    }
  ]
}